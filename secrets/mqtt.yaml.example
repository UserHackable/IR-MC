# Copy to secrets/mqtt.yaml and fill in the local broker.
# secrets/mqtt.yaml is gitignored — never commit it.
#
# Included in the same NVS image as Wi‑Fi when you run:
#   ./scripts/fw idf nvs-wifi
#
# Leave username/password empty for an open local Mosquitto.
# You can also set these later with POST /config/mqtt (stored in NVS).

---
uri: mqtt://192.168.1.10:1883
username: ""
password: ""
prefix: ir
